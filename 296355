  const playBtn = document.getElementById('playBtn');
  let isPlaying = false;

  audio.playbackRate = 1.0;
  audio.volume = 0.4;

  function setLang(lang) {
    currentLang = lang;
    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.classList.toggle('active', btn.textContent.includes(lang === 's' ? '简' : '繁'));
    });
    document.querySelectorAll('[data-s]').forEach(el => {
      if (el.tagName === 'TEXTAREA' || el.tagName === 'INPUT') return;
      el.textContent = el.getAttribute('data-' + lang);
    });
    playBtn.textContent = isPlaying ? (lang === 's' ? '暂停' : '暫停') : (lang === 's' ? '播放' : '播放');
    const placeholder = document.getElementById('boardInput');
    if (placeholder) placeholder.placeholder = lang === 's' ? '输入任何内容...' : '輸入任何內容...';
  }

  function showSection(id) {
    document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.classList.remove('active');
      if (btn.getAttribute('onclick') && btn.getAttribute('onclick').includes(id)) {
        btn.classList.add('active');
      }
    });
  }

  function togglePlay() {
    if (isPlaying) {
      audio.pause();
      playBtn.textContent = currentLang === 's' ? '播放' : '播放';
    } else {
      audio.play().catch(e => {
        alert(currentLang === 's' ? '播放失败，请检查音频文件是否存在。' : '播放失敗，請檢查音頻文件是否存在。');
      });
      playBtn.textContent = currentLang === 's' ? '暂停' : '暫停';
    }
    isPlaying = !isPlaying;
  }

  function setVol(v) {
    audio.volume = parseFloat(v);
  }

  // 留言板
  function loadMessages() {
    const list = document.getElementById('boardList');
    const msgs = JSON.parse(localStorage.getItem('liusi_board') || '[]');
    if (msgs.length === 0) {
      list.innerHTML = '<div class="board-empty">' + (currentLang === 's' ? '暂时没有留言' : '暫時沒有留言') + '</div>';
      return;
    }
    list.innerHTML = msgs.map(m => `
      <div class="board-item">
        <div>${escapeHtml(m.text)}</div>
        <div class="time">${m.time}</div>
      </div>
    `).join('');
  }

  function addMessage() {
    const input = document.getElementById('boardInput');
    const text = input.value.trim();
    if (!text) return;
    const msgs = JSON.parse(localStorage.getItem('liusi_board') || '[]');
    const now = new Date();
    const timeStr = now.getFullYear() + '-' + 
      String(now.getMonth()+1).padStart(2,'0') + '-' + 
      String(now.getDate()).padStart(2,'0') + ' ' + 
      String(now.getHours()).padStart(2,'0') + ':' + 
      String(now.getMinutes()).padStart(2,'0');
    msgs.unshift({ text: text, time: timeStr });
    if (msgs.length > 100) msgs.pop();
    localStorage.setItem('liusi_board', JSON.stringify(msgs));
    input.value = '';
    loadMessages();
  }

  function escapeHtml(str) {
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  loadMessages();
</script>
</body>
</html>
